# Gnani STT and TTS
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_LANGUAGE=mr-IN,hi-IN,en-IN
GNANI_STT_FORMAT=transcribe
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Kaveri

# Optional AI responses
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Government mandi data
DATA_GOV_IN_API_KEY=
DATA_GOV_RESOURCE_ID=
DATA_GOV_API_URL=
DATA_GOV_STATE=Maharashtra
DATA_GOV_LIMIT=1000
DATA_GOV_TIMEOUT_SECONDS=30
DATA_GOV_TRANSPORT=auto
DATA_GOV_CURL_URL_IN_ARGS=false

# Price cache
PRICE_CACHE_SECONDS=900
PRICE_STALE_HOURS=72

# Application settings
SAUDAVANI_DB_PATH=saudavani.db
DEMO_ADVANCE_PERCENT=20
DEMO_SINGLE_PARTY_LOCK=false
DEMO_ALLOW_UNAUTHENTICATED_ACTIONS=false
MAX_AUDIO_BYTES=15728640
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
PORT=8000

# Optional system executable paths
FFMPEG_BIN=ffmpeg
CURL_BIN=
